#!/usr/bin/env bash
# Freeze guard: the desktop's last line of defence, run every minute by
# pc-freeze-guard.timer (and on demand by pc-watch's notification).
#
# Cgroup caps and the idle gate stop a background job from *choosing* to be
# heavy. This catches what they cannot: many modest things adding up, or one
# thing outgrowing its caps.
#
#   reclaim  swap >= 70%: TERM idle desktop utilities sitting on swap. The
#            only action that gives swap back: a frozen process keeps every
#            swapped page; a dead one frees them.
#   freeze   lagging for 2 checks in a row: freeze every unit running in
#            background.slice (systemd's cgroup freezer: no CPU, no I/O)
#   stop     still lagging 5 checks in a row: stop the frozen units so their
#            memory is released. They are resumable batch jobs; their timers
#            start them again.
#   thaw     once the machine is smooth again, thaw whatever was frozen
#
# "Lagging" is the shared verdict in ~/.local/lib/pc/gauges.sh (pressure
# stalls first, fill levels second, all percentages of this machine).
#
# Only units inside background.slice are frozen or stopped, so a browser, the
# desktop, a terminal, or a shell that merely mentions a job's name can never
# be caught - the guard used to match command lines and once froze a shell.
#
#   pc-freeze-guard              one check (the timer runs this)
#   pc-freeze-guard --freeze     freeze background jobs now
#   pc-freeze-guard --thaw       thaw them now
#
# ~/.config/pc-guard/reclaim.list overrides the process names safe to TERM.

set -uo pipefail

. "$HOME/.local/lib/pc/gauges.sh"

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pc-guard"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/pc-freeze-guard"
LOG="$STATE_DIR/guard.log"
FROZEN="$STATE_DIR/frozen"
STRIKES="$STATE_DIR/strikes"
mkdir -p "$STATE_DIR"

SWAP_WARN_PCT="${GUARD_SWAP_WARN_PCT:-70}"
FREEZE_AFTER="${GUARD_FREEZE_AFTER:-2}"
STOP_AFTER="${GUARD_STOP_AFTER:-5}"
RECLAIM_MIN_MB="${GUARD_RECLAIM_MIN_MB:-150}"
RECLAIM_COOLDOWN="${GUARD_RECLAIM_COOLDOWN:-900}"

log() { printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }

# Units currently running in background.slice, read from the cgroup tree.
background_units() {
    local slice="/sys/fs/cgroup/user.slice/user-$UID.slice/user@$UID.service/background.slice" dir
    for dir in "$slice"/*.service; do
        [ -d "$dir" ] || continue
        # cgroupfs files always report size 0, so test for content by reading.
        read -r _ < "$dir/cgroup.procs" 2>/dev/null && basename "$dir"
    done
}

freeze_all() {
    local unit n=0
    while read -r unit; do
        grep -qx "$unit" "$FROZEN" 2>/dev/null && continue
        if systemctl --user freeze "$unit" 2>/dev/null; then
            echo "$unit" >> "$FROZEN"
            n=$((n + 1))
            log "freeze: $unit ($1)"
        fi
    done < <(background_units)
    echo "$n"
}

thaw_all() {
    [ -s "$FROZEN" ] || { echo 0; return; }
    local unit n=0
    while read -r unit; do
        systemctl --user thaw "$unit" 2>/dev/null && n=$((n + 1))
    done < "$FROZEN"
    : > "$FROZEN"
    log "thaw: $n unit(s) ($1)"
    echo "$n"
}

case "${1:-}" in
    --freeze) echo "Froze $(freeze_all "requested") background job(s)"; exit 0 ;;
    --thaw) echo "Thawed $(thaw_all "requested") background job(s)"; exit 0 ;;
esac

gauge_read
gauge_verdict
gauges="mem=${GAUGE_MEM_USED_PCT}% swap=${GAUGE_SWAP_PCT}% psi=${GAUGE_PSI_MEM}/${GAUGE_PSI_IO} temp=${GAUGE_TEMP_C:-?}"

# --- Reclaim: give swap back on warning-level swap --------------------------

reclaim_names() {
    if [ -f "$CONF_DIR/reclaim.list" ]; then
        sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$CONF_DIR/reclaim.list"
    else
        # Desktop utilities that idle for hours on hundreds of MB and are
        # relaunched on demand. Never browsers, mail, or anything with state.
        printf '%s\n' gnome-software tracker-miner-fs-3 tracker-extract-3 update-notifier
    fi
}

if [ "$GAUGE_SWAP_PCT" -ge "$SWAP_WARN_PCT" ]; then
    now=$(date +%s)
    while read -r name; do
        comm=${name:0:15}   # /proc/<pid>/comm is truncated to 15 characters
        for pid in $(pgrep -u "$UID" -x "$comm" 2>/dev/null); do
            swap_kb=$(awk '/^VmSwap:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
            [ "$(( ${swap_kb:-0} / 1024 ))" -ge "$RECLAIM_MIN_MB" ] || continue
            stamp="$STATE_DIR/reclaimed.$comm"
            [ -f "$stamp" ] && [ $(( now - $(cat "$stamp") )) -lt "$RECLAIM_COOLDOWN" ] && continue
            kill -TERM "$pid" 2>/dev/null || continue
            echo "$now" > "$stamp"
            log "reclaim: TERM $comm ($pid) holding $(( swap_kb / 1024 ))MB swap ($gauges)"
        done
    done < <(reclaim_names)
fi

# --- Escalation -------------------------------------------------------------

if [ "$GAUGE_LEVEL" != crit ]; then
    [ -s "$FROZEN" ] && thaw_all "smooth again: $gauges" > /dev/null
    echo 0 > "$STRIKES"
    exit 0
fi

strikes=$(( $(cat "$STRIKES" 2>/dev/null || echo 0) + 1 ))
echo "$strikes" > "$STRIKES"
log "lagging, strike $strikes: $GAUGE_REASONS ($gauges)"

if [ "$strikes" -ge "$STOP_AFTER" ] && [ -s "$FROZEN" ]; then
    while read -r unit; do
        systemctl --user thaw "$unit" 2>/dev/null
        systemctl --user stop "$unit" 2>/dev/null && log "stop: $unit"
    done < "$FROZEN"
    : > "$FROZEN"
elif [ "$strikes" -ge "$FREEZE_AFTER" ]; then
    freeze_all "$GAUGE_REASONS" > /dev/null
fi

exit 0
