#!/usr/bin/env bash
# Stable suspend on NVIDIA laptops: prefer deep (S3) sleep over s2idle, and
# disable hybrid sleep, which hangs on resume with the proprietary driver.
#
#   sudo fix-pc-sleep
#
# Writes two small drop-ins and refreshes GRUB. Never suspends or reboots.

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo:" >&2
    echo "  sudo $(readlink -f "$0")" >&2
    exit 1
fi

install -d -m 0755 /etc/default/grub.d /etc/systemd/sleep.conf.d

cat > /etc/default/grub.d/99-nvidia-deep-sleep.cfg <<'CFG'
GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT mem_sleep_default=deep"
CFG

cat > /etc/systemd/sleep.conf.d/99-nvidia-stable-sleep.conf <<'CFG'
[Sleep]
AllowHybridSleep=no
CFG

if [ -w /sys/power/mem_sleep ]; then
    printf 'deep\n' > /sys/power/mem_sleep
fi

update-grub
systemctl daemon-reload
systemctl reset-failed systemd-hybrid-sleep.service 2>/dev/null || true

echo "Stable laptop sleep configuration installed."
echo "Deep suspend is selected and hybrid sleep is disabled."
printf 'Current sleep modes: '
cat /sys/power/mem_sleep
echo "No reboot or suspend was triggered."
