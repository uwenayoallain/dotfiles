#!/usr/bin/env bash

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command with sudo:" >&2
    echo "  sudo $HOME/.local/bin/fix-pc-sleep" >&2
    exit 1
fi

media_server_assets="$HOME/.local/share/media-server"

/usr/bin/install -d -m 0755 /etc/default/grub.d
/usr/bin/install -d -m 0755 /etc/systemd/sleep.conf.d
/usr/bin/install -m 0644 \
    "$media_server_assets/99-nvidia-deep-sleep.cfg" \
    /etc/default/grub.d/99-nvidia-deep-sleep.cfg
/usr/bin/install -m 0644 \
    "$media_server_assets/99-nvidia-stable-sleep.conf" \
    /etc/systemd/sleep.conf.d/99-nvidia-stable-sleep.conf

if [ -w /sys/power/mem_sleep ]; then
    printf 'deep\n' > /sys/power/mem_sleep
fi

/usr/sbin/update-grub
/usr/bin/systemctl daemon-reload
/usr/bin/systemctl reset-failed systemd-hybrid-sleep.service 2>/dev/null || true

echo "Stable laptop sleep configuration installed."
echo "Deep suspend is selected and hybrid sleep is disabled."
printf 'Current sleep modes: '
/usr/bin/cat /sys/power/mem_sleep
echo "No reboot or suspend was triggered."
